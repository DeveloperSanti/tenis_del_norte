# ═══════════════════════════════════════════════════
# Tenis del Norte — URLs limpias (sin .html)
# ═══════════════════════════════════════════════════

Options -MultiViews -Indexes
RewriteEngine On

DirectoryIndex index.html index.php

# 1) /index.html → /  (canonicalización de la raíz)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 2) /algo.html → /algo  (resto de páginas .html)
RewriteCond %{THE_REQUEST} \s/+([^\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) Reescritura interna: /algo → /algo.html (si el .html existe)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# 4) Bloquear acceso directo a archivos sensibles
<FilesMatch "^(\.htaccess|setup\.sql)$">
    Require all denied
</FilesMatch>

# 5) Bloquear acceso al config.php desde la web
<Files "config.php">
    Require all denied
</Files>

# ═══════════════════════════════════════════════════
# CACHÉ DE NAVEGADOR — acelera cargas repetidas
# ═══════════════════════════════════════════════════
<IfModule mod_expires.c>
    ExpiresActive On
    # Imágenes: 1 año (los nombres son únicos por subida, no hay riesgo de versión vieja)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # Fuentes
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Imágenes y fuentes: nombres únicos → caché larga y agresiva
    <FilesMatch "\.(webp|jpe?g|png|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # CSS y JS: el navegador SIEMPRE revalida (304 si no cambió).
    # Así cada deploy se ve al instante, sin esperar a que expire la caché.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # HTML/PHP: nunca cachear (contenido dinámico)
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ═══════════════════════════════════════════════════
# COMPRESIÓN GZIP — texto/CSS/JS/JSON más livianos
# ═══════════════════════════════════════════════════
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
